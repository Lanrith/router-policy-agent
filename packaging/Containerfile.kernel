# Isolated test environment; no deployment configuration or credentials.
FROM docker.io/library/golang@sha256:cf7e928cb9edc2ed8b3cc6fe77ee1ee30b9fea28149564c8840097321a7600ea
RUN apt-get update && apt-get install -y --no-install-recommends nftables=1.1.3-1 iproute2=6.15.0-1
ENV GOTOOLCHAIN=local
COPY go.mod go.sum /build-dependencies/
RUN cd /build-dependencies && go mod download && go mod verify
WORKDIR /workspace
